<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FocusMark" WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height" Width="360" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="#22252B" Foreground="#F1F2F4" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#343A43"/><Setter Property="Foreground" Value="#F1F2F4"/><Setter Property="Padding" Value="10,5"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Button Name="Pill" Height="32" Visibility="Collapsed" Padding="12,0" Background="#292E36" ToolTip="点击查看 · 中键隐藏" AutomationProperties.Name="展开备注">
   <DockPanel><Ellipse DockPanel.Dock="Left" Width="6" Height="6" Margin="0,0,8,0" Fill="#9ED4BC"/><TextBlock Name="Preview" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
  </Button>
  <StackPanel Name="Editor" Visibility="Collapsed" Margin="16,12">
   <Label Target="{Binding ElementName=Input}" Content="下一步做什么？" Foreground="#F1F2F4" Padding="0,0,0,8"/>
   <TextBox Name="Input" AutomationProperties.Name="下一步做什么？" Background="#191C21" Foreground="#F1F2F4" CaretBrush="White" BorderBrush="#738C83" Padding="8,6" TextWrapping="Wrap" MaxLines="5" VerticalScrollBarVisibility="Auto"/>
   <DockPanel Margin="0,10,0,0"><Button Name="Save" DockPanel.Dock="Right" Content="保存" Background="#405D51"/><TextBlock Name="Count" Foreground="#BEC5CF" VerticalAlignment="Center" FontSize="12"/></DockPanel>
  </StackPanel>
  <StackPanel Name="Details" Visibility="Collapsed" Margin="16,12">
   <TextBlock Name="FullNote" TextWrapping="Wrap"/>
   <TextBlock Name="Status" Margin="0,7,0,0" FontSize="12" Foreground="#E6C59E" TextWrapping="Wrap"/>
   <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Name="Return" Content="返回原窗口" Background="#405D51"/><Button Name="Edit" Content="编辑" Margin="7,0"/><Button Name="Done" Content="完成"/></StackPanel>
  </StackPanel>
 </Grid>
</Window>
