<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FocusMark" WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height" Width="360" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True">
 <Window.Resources>
  <Geometry x:Key="Bookmark">M1,1 H11 V16 L6,12.7 L1,16 Z M4,5 V6.5 H8 V5 Z</Geometry>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Control}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="10,5"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="surface" BorderThickness="1" BorderBrush="Transparent" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="{DynamicResource Mint}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Background" Value="{DynamicResource Pressed}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Button Name="Pill" Height="32" Visibility="Collapsed" Padding="12,0" Background="{DynamicResource PillSurface}" ToolTip="点击查看 · 中键隐藏" AutomationProperties.Name="展开备注">
   <Grid><Border Name="Grip" Visibility="Collapsed" Width="30" Height="4" CornerRadius="2" Background="{DynamicResource Mint}"/><DockPanel Name="Summary"><Path DockPanel.Dock="Left" Data="{StaticResource Bookmark}" Fill="{DynamicResource Mint}" Width="12" Height="17" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Name="Preview" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></Grid>
  </Button>
  <StackPanel Name="Editor" Visibility="Collapsed" Margin="18,15">
   <DockPanel Margin="0,0,0,9"><Path DockPanel.Dock="Left" Data="{StaticResource Bookmark}" Fill="{DynamicResource Mint}" Width="12" Height="17" Margin="0,0,8,0" VerticalAlignment="Center"/><Label Target="{Binding ElementName=Input}" Content="下一步做什么？" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Padding="0"/></DockPanel>
   <Border Background="{DynamicResource Field}" CornerRadius="7" Padding="9,7"><TextBox Name="Input" UndoLimit="16" AutomationProperties.Name="下一步做什么？" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" FontSize="15" TextWrapping="Wrap" MaxLines="5" VerticalScrollBarVisibility="Auto"/></Border>
   <CheckBox Name="Rebind" Visibility="Collapsed" Margin="0,8,0,0" Foreground="{DynamicResource Secondary}" Content="将返回目标改为刚才的窗口"/>
   <DockPanel Margin="0,13,0,0"><Button Name="Save" DockPanel.Dock="Right" Content="保存 ↵" AutomationProperties.Name="保存" Background="{DynamicResource Primary}"/><TextBlock Name="Count" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" FontSize="12"/></DockPanel>
  </StackPanel>
  <StackPanel Name="Details" Visibility="Collapsed" Margin="18,15">
   <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
   <DockPanel Margin="0,0,0,7"><Path DockPanel.Dock="Left" Data="{StaticResource Bookmark}" Fill="{DynamicResource Mint}" Stretch="Uniform" Width="10" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="下一步" Foreground="{DynamicResource Secondary}" FontSize="12"/></DockPanel>
   <TextBlock Name="FullNote" TextWrapping="Wrap" FontSize="15" LineHeight="23"/>
   <TextBlock Name="Status" Margin="0,7,0,0" FontSize="12" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"/>
   <DockPanel Margin="0,13,0,0"><Button DockPanel.Dock="Right" Name="Fold" Content="收起" Background="{DynamicResource Panel}"/><StackPanel Orientation="Horizontal"><Button Name="Return" Content="返回原窗口" Background="{DynamicResource Primary}"/><Button Name="Edit" Content="编辑" Margin="6,0"/><Button Name="Done" Content="完成" Background="{DynamicResource Panel}" ToolTip="清除当前备注"/></StackPanel></DockPanel>
  </StackPanel>
 </Grid>
</Window>
