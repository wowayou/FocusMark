<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FocusMark 设置" Width="454" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="RadioButton">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border Name="Tile" Background="Transparent" CornerRadius="6" Padding="3,7" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Control}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Primary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Mint}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border Name="Choice" Background="Transparent" Padding="10,5" CornerRadius="4"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource Primary}"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource Control}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Width" Value="156"/><Setter Property="Height" Value="31"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid><ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Name="Face" Background="{DynamicResource Field}" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Control}"><Grid Margin="10,0"><Path HorizontalAlignment="Right" VerticalAlignment="Center" Data="M0,1 L4,5 L8,1" Stroke="{DynamicResource Secondary}" StrokeThickness="1.4"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Stroke}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton><ContentPresenter Margin="11,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
    <Border Name="FocusOutline" IsHitTestVisible="False" CornerRadius="6" BorderThickness="1"/>
    <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"><Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="3"><ScrollViewer MaxHeight="224" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusOutline" Property="BorderBrush" Value="{DynamicResource Mint}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <DockPanel Background="Transparent"><Border Name="Track" DockPanel.Dock="Right" Width="36" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Stroke}" Background="{DynamicResource Field}"><Ellipse Name="Thumb" Fill="{DynamicResource Secondary}" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0"/></Border><ContentPresenter VerticalAlignment="Center"/></DockPanel>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Primary}"/><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Mint}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Mint}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Bottom" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Control}" BorderThickness="0,1,0,0" Padding="24,12"><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Name="Cancel" Content="取消" Padding="16,6" Margin="0,0,8,0"/><Button Name="Apply" IsDefault="True" Content="应用设置" Padding="16,6" Background="{DynamicResource Primary}"/></StackPanel></Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24,17,24,14">
   <DockPanel Margin="0,0,0,12"><Path DockPanel.Dock="Left" Data="{DynamicResource Bookmark}" Fill="{DynamicResource Mint}" Width="14" Height="19" Margin="0,0,9,0" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock Text="桌面书签" FontSize="21" FontWeight="SemiBold"/></DockPanel>
   <Border Background="{DynamicResource Field}" Height="94" CornerRadius="12" ClipToBounds="True" BorderBrush="{DynamicResource Control}" BorderThickness="1">
    <Grid Margin="4" Name="Stage">
     <Canvas Name="SampleArea" ClipToBounds="True">
     <Button Name="TrySample" AutomationProperties.Name="展开或收起示例备注" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand" Padding="0" ToolTip="点击试用"><Button.Template><ControlTemplate TargetType="Button"><Border Name="PreviewHit" BorderThickness="1" BorderBrush="Transparent" CornerRadius="18" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PreviewHit" Property="BorderBrush" Value="{DynamicResource Mint}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
      <Border Name="Sample" Background="{DynamicResource PillSurface}" CornerRadius="16" Padding="12,0"><Border.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Border.LayoutTransform><Grid><Border Name="SampleGrip" Width="30" Height="4" CornerRadius="2" Background="{DynamicResource Mint}"/><DockPanel Name="SampleSummary" HorizontalAlignment="Center" VerticalAlignment="Center"><Path DockPanel.Dock="Left" Data="{DynamicResource Bookmark}" Fill="{DynamicResource Mint}" Width="12" Height="17" Margin="0,0,8,0"/><TextBlock Name="SampleLabel" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel><StackPanel Name="SampleNote" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock Text="下一步" Foreground="{DynamicResource Secondary}" FontSize="11"/><TextBlock Text="读完下一段，再标出关键句。" Foreground="{DynamicResource Text}" Margin="0,3,0,0"/></StackPanel></Grid></Border></Button></Canvas>
     <StackPanel Name="HiddenHint" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="备注已隐藏" HorizontalAlignment="Center" Foreground="{DynamicResource Text}" FontWeight="SemiBold"/><TextBlock Name="RecallHint" Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource Secondary}" FontSize="12"/></StackPanel>
    </Grid>
   </Border>
   <Border Background="{DynamicResource Field}" CornerRadius="8" Margin="0,10,0,0" Padding="1"><UniformGrid Columns="3"><RadioButton Name="ShowPill" Content="显示胶囊" Foreground="{DynamicResource Text}"/><RadioButton Name="ShowEdge" Content="贴边收起" Foreground="{DynamicResource Text}"/><RadioButton Name="ShowNone" Content="完全隐藏" Foreground="{DynamicResource Text}"/></UniformGrid></Border>
   <TextBlock Name="Help" TextWrapping="Wrap" Foreground="{DynamicResource Secondary}" FontSize="12" Margin="2,6,0,14"/>
   <Border Background="{DynamicResource PillSurface}" BorderBrush="{DynamicResource Control}" BorderThickness="1" CornerRadius="9" Padding="12,2"><StackPanel>
    <DockPanel Margin="0,5"><ComboBox DockPanel.Dock="Right" Name="Position" SelectedIndex="0"><ComboBoxItem Content="屏幕顶部"/><ComboBoxItem Content="屏幕底部"/><ComboBoxItem Content="屏幕左侧"/><ComboBoxItem Content="屏幕右侧"/></ComboBox><Label Content="停靠位置" Target="{Binding ElementName=Position}"/></DockPanel>
    <DockPanel Margin="0,3"><TextBlock Name="Percent" DockPanel.Dock="Right" Width="44" TextAlignment="Right" Foreground="{DynamicResource Secondary}"/><Label DockPanel.Dock="Left" Content="沿边位置" Target="{Binding ElementName=Along}"/><Slider Name="Along" Margin="20,0,0,0" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"/></DockPanel>
    <Separator Background="{DynamicResource Control}"/>
    <CheckBox Name="Mask" Content="隐藏胶囊上的文字" Foreground="{DynamicResource Text}" Margin="0,8"/>
   </StackPanel></Border>
   <Border Background="{DynamicResource PillSurface}" BorderBrush="{DynamicResource Control}" BorderThickness="1" CornerRadius="9" Padding="12,2" Margin="0,8,0,0"><StackPanel>
    <DockPanel Margin="0,5"><Button DockPanel.Dock="Right" Name="Letter" MinWidth="156" ToolTip="点击后按下新的组合键，Esc 取消录入"/><Label Content="唤出快捷键" Target="{Binding ElementName=Letter}"/></DockPanel>
    <Separator Background="{DynamicResource Control}"/>
    <DockPanel Margin="0,5"><ComboBox DockPanel.Dock="Right" Name="Palette"/><StackPanel Orientation="Horizontal"><Label Content="主题" Target="{Binding ElementName=Palette}"/><Button Name="Folder" Content="主题目录 ↗" ToolTip="打开自定义主题目录" Background="Transparent" Foreground="{DynamicResource Secondary}" FontSize="12" Padding="5,2" Margin="5,0,0,0"/></StackPanel></DockPanel>
   </StackPanel></Border>
   <CheckBox Name="Animate" Content="展开备注时使用动效" Foreground="{DynamicResource Secondary}" Margin="12,8"/>
   <TextBlock Name="Error" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Visibility="Collapsed" Margin="2,8,0,0"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
